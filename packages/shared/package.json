{
  "name": "@roamcli/shared",
  "version": "1.1.0",
  "description": "Shared protocol and security utilities for RoamCli.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/CharAznable98/roam-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharAznable98/roam-cli.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/CharAznable98/roam-cli/issues"
  },
  "keywords": [
    "roamcli",
    "protocol",
    "ai-coding-agent",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
