{
  "name": "roamcli",
  "version": "1.1.0",
  "private": true,
  "description": "Self-hosted web control plane for Codex, Claude Code, and AI coding agents running on your own machines.",
  "license": "MIT",
  "homepage": "https://github.com/CharAznable98/roam-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharAznable98/roam-cli.git"
  },
  "bugs": {
    "url": "https://github.com/CharAznable98/roam-cli/issues"
  },
  "keywords": [
    "ai-coding-agent",
    "coding-agent",
    "codex",
    "claude-code",
    "self-hosted",
    "web-ui",
    "agent-runner",
    "control-plane"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @roamcli/shared --filter @roamcli/agent-plugin-sdk --filter @roamcli/agent-codex --filter @roamcli/agent-claude-code --filter @roamcli/agent-pi build",
    "blackbox:browser": "pnpm build && node scripts/blackbox-browser.mjs",
    "pin-show-more:browser": "pnpm build && node scripts/pin-show-more-browser.mjs",
    "dev": "pnpm --filter @roamcli/server dev",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "test:pi:e2e": "pnpm build:packages && pnpm --filter @roamcli/server --filter @roamcli/runner build && node scripts/pi-e2e.mjs",
    "test": "vitest run",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm build:packages && pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
